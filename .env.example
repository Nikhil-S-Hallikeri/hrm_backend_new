# Django Settings
SECRET_KEY=your-django-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,anotherdomain.com

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=3306

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_PORT=465
EMAIL_USE_SSL=True

# Celery Settings
CELERY_BROKER_URL=redis://your-redis-url:port

# Meta / WhatsApp Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CONFIG_ID=your_meta_config_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
DJANGO_RUNSERVER_ADDR=https://your-backend-api-domain.com

# Chatbot Service
CHATBOT_SERVICE_URL=http://localhost:8002
